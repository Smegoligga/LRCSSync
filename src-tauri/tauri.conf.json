{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LRCSSync",
  "version": "0.2.1",
  "identifier": "com.lrcssync.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LRCSSync",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Sync .lrc lyrics",
    "longDescription": "Time lyrics to a song with a waveform, a voice frequency view, tap-sync and fine nudging, then save them as .lrc.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
