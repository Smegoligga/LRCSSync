{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-analyze",
    "allow-embed-lyrics",
    "allow-read-lyrics",
    "allow-open-genius",
    "allow-genius-lyrics",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://genius.com/*" }, { "url": "https://*.genius.com/*" }]
    },
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }, { "path": "/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://lrclib.net/*" }, { "url": "https://genius.com/*" }]
    }
  ]
}
